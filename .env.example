# Copy to .env (git-ignored) and fill in. Real environment variables win over this file.

# Voice: plain, prime, custom or elevenlabs
ROLLOUT_TTS_STYLE=prime

# ElevenLabs (optional, needs internet and uses your ElevenLabs credits)
# ELEVENLABS_API_KEY=
# ROLLOUT_ELEVENLABS_VOICE_ID=

# On-screen emblem when you say "Hey Prime" (menu bar app). Set ROLLOUT_OVERLAY=0 to turn it off.
# ROLLOUT_OVERLAY_POSITION=bottom
# Use your own picture instead of the built-in crest, e.g. a transparent PNG kept outside the repo
# ROLLOUT_OVERLAY_IMAGE=~/Pictures/autobot.png
